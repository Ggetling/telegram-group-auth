# Copy to .env and fill in. Never commit the filled-in copy.

# From @BotFather.
BOT_TOKEN=

# Your own numeric Telegram id, from @userinfobot. Comma-separated for several.
# Administrators always get in, with or without a group, and are the only ones
# who may bind a group under the default bind_on_add policy.
AUTH_ADMIN_IDS=

# Groups whose members are users of the bot. Leave empty to bind by simply
# adding the bot to a group. A supergroup id looks like -1001234567890.
AUTH_GROUP_IDS=

# Everything below is optional; these are the defaults.
# AUTH_CACHE_TTL=300
# AUTH_DENY_CACHE_TTL=60
# AUTH_GRACE=900
# AUTH_PRIVATE_ONLY=1
# AUTH_BIND_ON_ADD=admin_only
# AUTH_DB=auth.db
